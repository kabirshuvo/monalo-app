# Copy to .dev.vars for local `npm run preview` (Workers runtime).
# Copy to .env.local for `npm run dev`.
NEXTJS_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GALLERY_URL=http://gallery.localhost:3000

# Cloudflare R2 (optional locally — falls back to public/uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=monalo-media
R2_PUBLIC_BASE_URL=
