# Copy to .dev.vars for local `npm run preview` (Workers runtime).
# Copy to .env.local for `npm run dev`.
NEXTJS_ENV=development

# Worker runtime: use Prisma Accelerate URL (see docs/PRISMA_ACCELERATE.md)
DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY

# Local migrations/seed only (direct Neon — never commit real values)
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Auth.js v5 (NEXTAUTH_* still supported)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GALLERY_URL=http://gallery.localhost:3000

# Resend (email verification)
RESEND_API_KEY=
RESEND_FROM_EMAIL="MonAlo <onboarding@resend.dev>"

# Google OAuth — project monaloauth
# https://console.cloud.google.com/apis/credentials?project=monaloauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 — account 551aa3726dff734e7e9a82fc748927c4
R2_ACCOUNT_ID=551aa3726dff734e7e9a82fc748927c4
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# General media bucket (avatars, gallery) → media.monalo.school
R2_BUCKET_NAME=monalomedia
R2_PUBLIC_BASE_URL=https://media.monalo.school
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.monalo.school

# Eco Penguin — monalomedia bucket under eco-penguine/ prefix.
# Upload once with: npm run ecopenguin:upload-r2  (see docs/ECO_PENGUIN_R2.md)
ECO_PENGUIN_R2_BUCKET=monalomedia
ECO_PENGUIN_R2_PREFIX=eco-penguine
